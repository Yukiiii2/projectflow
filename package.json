{
  "name": "projectflow-stage1-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual:qa": "node scripts/visual-qa.mjs",
    "auth:qa": "node scripts/auth-qa.mjs",
    "workspace:qa": "node scripts/workspace-qa.mjs",
    "project-task:qa": "node scripts/project-task-qa.mjs",
    "kanban:qa": "node scripts/kanban-qa.mjs",
    "collaboration:qa": "node scripts/collaboration-qa.mjs",
    "stage-f:qa": "node scripts/stage-f-qa.mjs",
    "build:all": "npm run build && npm run verify:production-bundle && npm --prefix backend run build",
    "start": "npm --prefix backend start"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
