NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://projectflow:CHANGE_ME@localhost:5432/projectflow
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_ORIGIN=http://localhost:5173
INVITATION_TTL_HOURS=168
VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=false
TRUST_PROXY_HOPS=1
LOG_LEVEL=debug
# Local development returns a clearly labelled preview link instead of sending mail.
INVITATION_DELIVERY=preview
# For SMTP delivery, set INVITATION_DELIVERY=smtp and configure:
# Resend SMTP settings. Production requires a verified sender domain.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
# INVITATION_FROM=ProjectFlow <invites@example.com>
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# EMAIL_OUTBOX_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
