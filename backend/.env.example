NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://projectflow:CHANGE_ME@localhost:5432/projectflow
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_ORIGIN=http://localhost:5173
INVITATION_TTL_HOURS=168
# Local development returns a clearly labelled preview link instead of sending mail.
INVITATION_DELIVERY=preview
# For SMTP delivery, set INVITATION_DELIVERY=smtp and configure:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# INVITATION_FROM=ProjectFlow <invites@example.com>
