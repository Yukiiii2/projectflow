NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://projectflow:CHANGE_ME@localhost:5432/projectflow
# Production migrations only: use Neon's direct (non-pooler) TLS URL in the operator shell.
# MIGRATION_DATABASE_URL=postgresql://projectflow:CHANGE_ME@ep-example.example.neon.tech/projectflow?sslmode=require
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_ORIGIN=http://localhost:5173
INVITATION_TTL_HOURS=168
VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=false
TRUST_PROXY_HOPS=1
LOG_LEVEL=debug
# Disabled by default. Enable only after migration 006 and runtime grants are verified.
DEMO_MODE_ENABLED=false
# Local development returns a clearly labelled preview link instead of sending mail.
INVITATION_DELIVERY=preview
# Render Free: use Resend's HTTPS API. Production requires a verified custom sender domain;
# Resend's @resend.dev testing sender is intentionally rejected because it cannot serve public registration.
# Local browser QA injects an in-process capture transport; there is intentionally no capture environment mode.
# INVITATION_DELIVERY=resend
# RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# INVITATION_FROM=ProjectFlow <invites@example.com>
# Optional SMTP compatibility for hosts that permit outbound SMTP:
# INVITATION_DELIVERY=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# Resend: 465 or 2465 uses implicit TLS; 587 or 2587 requires STARTTLS. Production rejects other ports.
# SMTP_USER=resend
# SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# EMAIL_OUTBOX_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
